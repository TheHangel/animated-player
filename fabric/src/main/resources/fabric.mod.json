{
  "schemaVersion": 1,
  "id": "animatedplayer",
  "version": "${mod_version}",
  "name": "${mod_name}",
  "description": "${mod_description}",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.hangel.animatedplayer.fabric.AnimatedPlayerFabric"
    ],
    "modmenu": [
      "dev.hangel.animatedplayer.fabric.ModMenuIntegration"
    ]
  },
  "mixins": [
    "animatedplayer.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "fabric-api": "*",
    "minecraft": "${minecraft_version}",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*"
  },
  "icon": "assets/animatedplayer/icon.png"
}
